<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
            <!-- 显式 UTF-8：Windows 终端需 chcp 65001 或在 IDEA 控制台查看中文日志 -->
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 心跳重试（默认 100ms）对不可达节点会逐次 reconnect 并打 WARN——高频噪音。
         可达性变化已由 Raft 传输层"节点不可达/恢复可达"单次提示，这里压到 ERROR，
         其他异常仍可见。 -->
    <logger name="com.ispengya.remoting.netty.NettyRemotingClient" level="ERROR"/>

    <!-- 按需对单包开 debug：<logger name="com.ispengya.polyconfig" level="DEBUG"/> -->
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
